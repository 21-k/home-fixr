# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# python
__pycache__/
*.pyc

# production ops workspace (links, pushes) - never commit
.prod/

# playwright
/e2e/.auth/
/e2e/.results/
/e2e/.results-live/
/e2e/.report/
/e2e/.report-live/
/e2e/reports/local-crawl/
/e2e/reports/live/desktop/
/e2e/reports/live/mobile/
